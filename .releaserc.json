{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "fix", "scope": "ci", "release": false },
          { "breaking": true, "release": "minor" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "scope": "!ci", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "semantic-release-cargo",
      { "publish": true, "alwaysVerifyToken": true }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cargo generate-lockfile && nix-shell --run 'just manpage'"
      }
    ],
    "@semantic-release/changelog",
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock", "CHANGELOG.md", "docs/daemonize.1"],
        "message": "chore(release): ${nextRelease.version}"
      }
    ],
    "@semantic-release/github"
  ]
}
